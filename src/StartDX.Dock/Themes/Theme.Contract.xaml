<!--
  ╔══════════════════════════════════════════════════════════════════════════════════════════╗
  ║  THEME CONTRACT  -  merged slot [0]. Defines EVERY token with a neutral dark default.     ║
  ║                                                                                          ║
  ║  HOW TO WRITE A THEME                                                                    ║
  ║   1. Copy this file to Themes/MyTheme.xaml (build action: Page - the default).           ║
  ║   2. Keep the same x:Key names; change the values. You may omit any key: this file's      ║
  ║      value is used as the fallback, so a partial theme still renders correctly.           ║
  ║   3. Register it:  ThemeManager.Instance.Register(descriptor, packUri)  and add the id    ║
  ║      to ThemeCatalog (or call Register from a plug-in assembly).                          ║
  ║                                                                                          ║
  ║  TOKEN GROUPS                                                                            ║
  ║   Theme.Backdrop.*   applied to the HWND by DWM (blur/acrylic/mica, corners, border)      ║
  ║   Theme.Font.*       typography                                                          ║
  ║   Theme.Motion.*     hover / open animation parameters (read by code at run time)        ║
  ║   Theme.Text.* / Theme.Accent*                                                           ║
  ║   Theme.Dock.*       the docked bar surface                                              ║
  ║   Theme.Flyout.*     Start menu + notification centre surface                            ║
  ║   Theme.Button.* / Theme.Item.*   dock buttons and the active-window indicator           ║
  ║   Theme.Bevel.*      optional two-layer 3D edges (classic looks); zero/transparent = off ║
  ║   Theme.Input.* / Theme.List.*    search box and list rows                               ║
  ║   Theme.Tile.*       128x128 DIP graphics tiles (see "TILE ART" below)                    ║
  ║                                                                                          ║
  ║  TILE ART (128 x 128)                                                                    ║
  ║   A tile is laid out at Theme.Tile.Size (128) DIPs. Author bitmap art at 256 x 256 px     ║
  ║   (i.e. @2x) and point Theme.Tile.ArtOverlay at it; WPF downsamples with HighQuality      ║
  ║   scaling at 100% DPI and shows it 1:1 at 200%. App icons are fetched at 256px through    ║
  ║   IShellItemImageFactory, so tiles stay razor sharp. The plate itself is layered:         ║
  ║   Plate (fill+border+effect)  ->  Sheen (gradient lighting)  ->  ArtOverlay (bitmap)     ║
  ║   ->  AccentBar  ->  app icon + caption.                                                  ║
  ╚══════════════════════════════════════════════════════════════════════════════════════════╝
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Backdrop (window-level, applied natively) ─────────────────────────────────────── -->
    <sys:String x:Key="Theme.Backdrop.Kind">None</sys:String>              <!-- None | Blur | Acrylic | Mica -->
    <Color x:Key="Theme.Backdrop.Tint">#CC101418</Color>                   <!-- ARGB tint over the blur -->
    <sys:Boolean x:Key="Theme.Backdrop.Dark">True</sys:Boolean>
    <sys:String x:Key="Theme.Backdrop.Corners">Round</sys:String>          <!-- Round | RoundSmall | Square -->
    <Color x:Key="Theme.Backdrop.BorderColor">#00000000</Color>            <!-- alpha 0 = no DWM border -->

    <!-- ── Typography ────────────────────────────────────────────────────────────────────── -->
    <FontFamily x:Key="Theme.Font.Family">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="Theme.Font.Size">13</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.Small">11.5</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.Header">15</sys:Double>

    <!-- ── Bevel (two-layer, optional). Light layer = top/left edges, dark layer = bottom/right edges. Themes without bevels
         leave these transparent/zero. Drawn as overlays, so they work on any aspect ratio (a diagonal gradient does not). -->
    <SolidColorBrush x:Key="Theme.Bevel.Light" Color="Transparent"/>
    <SolidColorBrush x:Key="Theme.Bevel.Dark" Color="Transparent"/>
    <Thickness x:Key="Theme.Bevel.LightThickness">0</Thickness>
    <Thickness x:Key="Theme.Bevel.DarkThickness">0</Thickness>

    <!-- ── Motion ────────────────────────────────────────────────────────────────────────── -->
    <sys:Double x:Key="Theme.Motion.HoverScale">1.04</sys:Double>
    <sys:Double x:Key="Theme.Motion.HoverMs">140</sys:Double>
    <sys:Double x:Key="Theme.Motion.OpenMs">200</sys:Double>
    <sys:Double x:Key="Theme.Motion.SlidePx">16</sys:Double>

    <!-- ── Text / accent ─────────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Text.Primary" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="Theme.Text.OnAccent" Color="#0B0C0F"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Theme.Accent.Soft" Color="#334CC2FF"/>

    <!-- ── Dock surface ──────────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Dock.Background" Color="#FF14171C"/>
    <SolidColorBrush x:Key="Theme.Dock.BorderBrush" Color="#FF2A2F38"/>
    <Thickness x:Key="Theme.Dock.BorderThickness">1</Thickness>

    <!-- ── Flyout surface ────────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Flyout.Background" Color="#F014171C"/>
    <SolidColorBrush x:Key="Theme.Flyout.BorderBrush" Color="#FF2A2F38"/>
    <Thickness x:Key="Theme.Flyout.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Theme.Flyout.CornerRadius">10</CornerRadius>
    <DropShadowEffect x:Key="Theme.Flyout.Effect" Color="Black" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.4"/>

    <!-- ── Buttons / active indicator ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Theme.Button.BorderBrush" Color="Transparent"/>
    <Thickness x:Key="Theme.Button.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Theme.Button.CornerRadius">6</CornerRadius>
    <SolidColorBrush x:Key="Theme.Button.HoverBackground" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Button.HoverBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Button.PressedBackground" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Button.PressedBorderBrush" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Item.ActiveBackground" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Theme.Item.ActiveIndicator" Color="#4CC2FF"/>
    <x:Null x:Key="Theme.Item.ActiveIndicatorEffect"/>

    <!-- ── Input / list ──────────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Theme.Input.Background" Color="#FF0E1014"/>
    <SolidColorBrush x:Key="Theme.Input.BorderBrush" Color="#FF2A2F38"/>
    <SolidColorBrush x:Key="Theme.Input.FocusBorderBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Theme.Input.Foreground" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Theme.Input.Placeholder" Color="#7B8494"/>
    <CornerRadius x:Key="Theme.Input.CornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="Theme.List.HoverBackground" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Theme.List.HoverForeground" Color="#F2F4F8"/>
    <CornerRadius x:Key="Theme.List.CornerRadius">6</CornerRadius>
    <SolidColorBrush x:Key="Theme.Separator" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Badge.Background" Color="#FFE5484D"/>
    <SolidColorBrush x:Key="Theme.Badge.Foreground" Color="White"/>
    <SolidColorBrush x:Key="Theme.Scroll.Thumb" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Scroll.ThumbHover" Color="#88FFFFFF"/>

    <!-- ── 128 x 128 tiles ───────────────────────────────────────────────────────────────── -->
    <sys:Double x:Key="Theme.Tile.Size">128</sys:Double>
    <sys:Double x:Key="Theme.Tile.IconSize">80</sys:Double>
    <SolidColorBrush x:Key="Theme.Tile.Plate.Background" Color="#FF1B1F26"/>
    <SolidColorBrush x:Key="Theme.Tile.Plate.BorderBrush" Color="#FF2A2F38"/>
    <Thickness x:Key="Theme.Tile.Plate.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Theme.Tile.Plate.CornerRadius">12</CornerRadius>
    <x:Null x:Key="Theme.Tile.Plate.Effect"/>
    <SolidColorBrush x:Key="Theme.Tile.Plate.HoverBorderBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Theme.Tile.Sheen" Color="Transparent"/>
    <SolidColorBrush x:Key="Theme.Tile.AccentBar" Color="Transparent"/>
    <x:Null x:Key="Theme.Tile.ArtOverlay"/>
</ResourceDictionary>
