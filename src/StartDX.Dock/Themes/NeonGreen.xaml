<!--
  NEON GREEN - true black surfaces, electric green (#39FF14) accents. Depth comes from glow rather than shadow: the active
  window indicator, focused search box, hovered tiles and flyout rims all emit green light onto the black.
  Green is used sparingly on large surfaces (borders, indicators, focus) so text stays high-contrast: near-white green-tinted
  text on black, and black text on the few solid-green elements (badge).
  Omitted keys (Theme.Bevel.*) fall back to Theme.Contract.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Backdrop: opaque black; DWM gets a dim green hairline so the window edge itself carries the theme -->
    <sys:String x:Key="Theme.Backdrop.Kind">None</sys:String>
    <Color x:Key="Theme.Backdrop.Tint">#FF000000</Color>
    <sys:Boolean x:Key="Theme.Backdrop.Dark">True</sys:Boolean>
    <sys:String x:Key="Theme.Backdrop.Corners">RoundSmall</sys:String>
    <Color x:Key="Theme.Backdrop.BorderColor">#FF1C7A10</Color>

    <!-- Type / motion -->
    <FontFamily x:Key="Theme.Font.Family">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="Theme.Font.Size">13</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.Small">11.5</sys:Double>
    <sys:Double x:Key="Theme.Font.Size.Header">14</sys:Double>
    <sys:Double x:Key="Theme.Motion.HoverScale">1.05</sys:Double>
    <sys:Double x:Key="Theme.Motion.HoverMs">120</sys:Double>
    <sys:Double x:Key="Theme.Motion.OpenMs">180</sys:Double>
    <sys:Double x:Key="Theme.Motion.SlidePx">14</sys:Double>

    <!-- Text / accent -->
    <SolidColorBrush x:Key="Theme.Text.Primary" Color="#FFE6FFE0"/>
    <SolidColorBrush x:Key="Theme.Text.Secondary" Color="#FF6FB864"/>
    <SolidColorBrush x:Key="Theme.Text.OnAccent" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF39FF14"/>
    <SolidColorBrush x:Key="Theme.Accent.Soft" Color="#3339FF14"/>

    <!-- Dock: black with a faint green wash rising from the bottom, and a glowing green hairline -->
    <LinearGradientBrush x:Key="Theme.Dock.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF050805" Offset="0"/>
        <GradientStop Color="#FF000000" Offset="0.6"/>
        <GradientStop Color="#FF041004" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Theme.Dock.BorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0F3F0A" Offset="0"/>
        <GradientStop Color="#FF39FF14" Offset="0.5"/>
        <GradientStop Color="#FF0F3F0A" Offset="1"/>
    </LinearGradientBrush>
    <Thickness x:Key="Theme.Dock.BorderThickness">1</Thickness>

    <!-- Flyouts: black glass with a neon rim and outward green glow -->
    <LinearGradientBrush x:Key="Theme.Flyout.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FA060B06" Offset="0"/>
        <GradientStop Color="#FA000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Theme.Flyout.BorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF39FF14" Offset="0"/>
        <GradientStop Color="#FF145A0C" Offset="0.55"/>
        <GradientStop Color="#FF39FF14" Offset="1"/>
    </LinearGradientBrush>
    <Thickness x:Key="Theme.Flyout.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Theme.Flyout.CornerRadius">10</CornerRadius>
    <DropShadowEffect x:Key="Theme.Flyout.Effect" Color="#FF39FF14" BlurRadius="30" ShadowDepth="0" Opacity="0.35"/>

    <!-- Buttons: invisible until hovered, then a green-tinted plate with a bright edge -->
    <SolidColorBrush x:Key="Theme.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Theme.Button.BorderBrush" Color="Transparent"/>
    <Thickness x:Key="Theme.Button.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Theme.Button.CornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="Theme.Button.HoverBackground" Color="#1839FF14"/>
    <SolidColorBrush x:Key="Theme.Button.HoverBorderBrush" Color="#8039FF14"/>
    <SolidColorBrush x:Key="Theme.Button.PressedBackground" Color="#3339FF14"/>
    <SolidColorBrush x:Key="Theme.Button.PressedBorderBrush" Color="#FF39FF14"/>
    <SolidColorBrush x:Key="Theme.Item.ActiveBackground" Color="#1039FF14"/>
    <SolidColorBrush x:Key="Theme.Item.ActiveIndicator" Color="#FF39FF14"/>
    <DropShadowEffect x:Key="Theme.Item.ActiveIndicatorEffect" Color="#FF39FF14" BlurRadius="10" ShadowDepth="0" Opacity="1"/>

    <!-- Input / list -->
    <SolidColorBrush x:Key="Theme.Input.Background" Color="#FF020402"/>
    <SolidColorBrush x:Key="Theme.Input.BorderBrush" Color="#FF1A5A12"/>
    <SolidColorBrush x:Key="Theme.Input.FocusBorderBrush" Color="#FF39FF14"/>
    <SolidColorBrush x:Key="Theme.Input.Foreground" Color="#FFE6FFE0"/>
    <SolidColorBrush x:Key="Theme.Input.Placeholder" Color="#FF3F7A38"/>
    <CornerRadius x:Key="Theme.Input.CornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="Theme.List.HoverBackground" Color="#2239FF14"/>
    <SolidColorBrush x:Key="Theme.List.HoverForeground" Color="#FFB8FFA8"/>
    <CornerRadius x:Key="Theme.List.CornerRadius">7</CornerRadius>
    <SolidColorBrush x:Key="Theme.Separator" Color="#FF14400E"/>
    <SolidColorBrush x:Key="Theme.Badge.Background" Color="#FF39FF14"/>
    <SolidColorBrush x:Key="Theme.Badge.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Theme.Scroll.Thumb" Color="#FF1E6A14"/>
    <SolidColorBrush x:Key="Theme.Scroll.ThumbHover" Color="#FF39FF14"/>

    <!-- 128x128 tiles: black plates, dark-green rim that ignites on hover, green underline, soft top light -->
    <sys:Double x:Key="Theme.Tile.Size">128</sys:Double>
    <sys:Double x:Key="Theme.Tile.IconSize">84</sys:Double>
    <LinearGradientBrush x:Key="Theme.Tile.Plate.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0A120A" Offset="0"/>
        <GradientStop Color="#FF010301" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Theme.Tile.Plate.BorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2A8A1C" Offset="0"/>
        <GradientStop Color="#FF0F3F0A" Offset="1"/>
    </LinearGradientBrush>
    <Thickness x:Key="Theme.Tile.Plate.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Theme.Tile.Plate.CornerRadius">12</CornerRadius>
    <DropShadowEffect x:Key="Theme.Tile.Plate.Effect" Color="#FF39FF14" BlurRadius="14" ShadowDepth="0" Opacity="0.18"/>
    <SolidColorBrush x:Key="Theme.Tile.Plate.HoverBorderBrush" Color="#FF39FF14"/>
    <LinearGradientBrush x:Key="Theme.Tile.Sheen" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#1839FF14" Offset="0"/>
        <GradientStop Color="#0039FF14" Offset="0.45"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Theme.Tile.AccentBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0039FF14" Offset="0"/>
        <GradientStop Color="#FF39FF14" Offset="0.5"/>
        <GradientStop Color="#0039FF14" Offset="1"/>
    </LinearGradientBrush>
    <BitmapImage x:Key="Theme.Tile.ArtOverlay" UriSource="pack://application:,,,/StartDX.Dock;component/Assets/Tiles/neon.png"/>
</ResourceDictionary>
