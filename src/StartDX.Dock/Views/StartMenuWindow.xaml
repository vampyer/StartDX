<views:FlyoutWindow x:Class="StartDX.Dock.Views.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StartDX.Dock.Views"
        xmlns:vm="clr-namespace:StartDX.Dock.ViewModels"
        Title="Start" Width="660" Height="740">

    <views:FlyoutWindow.Resources>
        <!-- Row in the "All apps" list -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:AppEntry}">
            <Button Style="{StaticResource List.RowButton}" Click="Row_Click" MouseRightButtonUp="Row_RightUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding SmallIcon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- No explicit Foreground: the row template flips it on hover (e.g. white on navy in Retro). -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource Theme.Font.Family}" FontSize="{DynamicResource Theme.Font.Size}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Content of a 128x128 tile: 256px icon (crisp @2x) above a caption. The plate itself is Tile.Button. -->
        <DataTemplate x:Key="TileContent" DataType="{x:Type vm:AppEntry}">
            <Grid>
                <Image Source="{Binding LargeIcon}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                       Width="{DynamicResource Theme.Tile.IconSize}" Height="{DynamicResource Theme.Tile.IconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="{DynamicResource Theme.Font.Size.Small}"
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center" Margin="10,0,10,16" MaxWidth="108"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:AppEntry}">
            <Button Style="{StaticResource Tile.Button}" Click="Row_Click" MouseRightButtonUp="Row_RightUp"
                    Content="{Binding}" ContentTemplate="{StaticResource TileContent}" ToolTip="{Binding Name}"/>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource Dock.ItemButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </views:FlyoutWindow.Resources>

    <Grid x:Name="FlyoutRoot">
    <Border
            Background="{DynamicResource Theme.Flyout.Background}"
            BorderBrush="{DynamicResource Theme.Flyout.BorderBrush}"
            BorderThickness="{DynamicResource Theme.Flyout.BorderThickness}"
            CornerRadius="{DynamicResource Theme.Flyout.CornerRadius}"
            Padding="20" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <TextBox x:Name="SearchBox" Style="{StaticResource Theme.SearchBox}" Height="46"
                     Tag="Search apps, or type a command and press Enter"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="Search_KeyDown"/>

            <Grid Grid.Row="1" Margin="0,16,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Application launcher list -->
                <DockPanel Margin="0,0,14,0">
                    <TextBlock DockPanel.Dock="Top" Text="All apps" Style="{StaticResource Text.Header}" Margin="4,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RunHint}"
                               TextWrapping="Wrap" Margin="4,0,4,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoResults}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource RowTemplate}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>

                <!-- Frequently used + pinned, as 128x128 tiles -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Visibility="{Binding FrequentVisibility}">
                            <TextBlock Text="Frequently used" Style="{StaticResource Text.Header}" Margin="6,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Frequent}" ItemTemplate="{StaticResource TileTemplate}"
                                          ItemsPanel="{StaticResource TilePanel}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding PinnedVisibility}" Margin="0,10,0,0">
                            <TextBlock Text="Pinned" Style="{StaticResource Text.Header}" Margin="6,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding PinnedTiles}" ItemTemplate="{StaticResource TileTemplate}"
                                          ItemsPanel="{StaticResource TilePanel}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="8,4"
                                   Text="Launch a few apps and they will show up here. Right-click any app to pin it to the dock.">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{x:Static views:BothEmptyConverter.Instance}">
                                    <Binding Path="Frequent.Count"/>
                                    <Binding Path="PinnedTiles.Count"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer: user + power -->
            <Grid Grid.Row="2">
                <Border Style="{StaticResource Theme.Separator.Style}" Height="1" VerticalAlignment="Top" Margin="0,0,0,0"/>
                <TextBlock Text="{Binding UserName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Style="{StaticResource FooterButton}" Content="&#xE713;" ToolTip="Dock settings" Click="Settings_Click"/>
                    <Button Style="{StaticResource FooterButton}" Content="&#xE72E;" ToolTip="Lock" Click="Lock_Click"/>
                    <Button Style="{StaticResource FooterButton}" Content="&#xE708;" ToolTip="Sleep" Click="Sleep_Click"/>
                    <Button Style="{StaticResource FooterButton}" Content="&#xE777;" ToolTip="Restart" Click="Restart_Click"/>
                    <Button Style="{StaticResource FooterButton}" Content="&#xE7E8;" ToolTip="Shut down" Click="Shutdown_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    <Border IsHitTestVisible="False" BorderThickness="{DynamicResource Theme.Bevel.LightThickness}" BorderBrush="{DynamicResource Theme.Bevel.Light}"/>
    <Border IsHitTestVisible="False" BorderThickness="{DynamicResource Theme.Bevel.DarkThickness}" BorderBrush="{DynamicResource Theme.Bevel.Dark}"/>
    </Grid>
</views:FlyoutWindow>
