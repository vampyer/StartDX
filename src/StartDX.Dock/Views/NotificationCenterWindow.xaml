<views:FlyoutWindow x:Class="StartDX.Dock.Views.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StartDX.Dock.Views"
        xmlns:vm="clr-namespace:StartDX.Dock.ViewModels"
        Title="Notifications" Width="380" Height="560">

    <views:FlyoutWindow.Resources>
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:NotificationItem}">
            <Border Margin="0,0,0,8" Padding="14,10"
                    Background="{DynamicResource Theme.Tile.Plate.Background}"
                    BorderBrush="{DynamicResource Theme.Tile.Plate.BorderBrush}"
                    BorderThickness="{DynamicResource Theme.Tile.Plate.BorderThickness}"
                    CornerRadius="{DynamicResource Theme.List.CornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Secondary}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,4,0,0"
                                   TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Body}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource Dock.ItemButton}" Click="Dismiss_Click"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Width="26" Height="26" Padding="0"
                            VerticalAlignment="Top" Margin="8,-2,-6,0" ToolTip="Dismiss"/>
                </Grid>
            </Border>
        </DataTemplate>
    </views:FlyoutWindow.Resources>

    <Grid x:Name="FlyoutRoot">
    <Border
            Background="{DynamicResource Theme.Flyout.Background}"
            BorderBrush="{DynamicResource Theme.Flyout.BorderBrush}"
            BorderThickness="{DynamicResource Theme.Flyout.BorderThickness}"
            CornerRadius="{DynamicResource Theme.Flyout.CornerRadius}"
            Padding="18" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="2,0,0,12">
                <Button DockPanel.Dock="Right" Content="Clear all" Style="{StaticResource Dock.ItemButton}" Click="Clear_Click"
                        Padding="12,6" Margin="0"/>
                <TextBlock Text="Notifications" Style="{StaticResource Text.Header}" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}"/>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Text="You&#x2019;re all caught up."
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
    <Border IsHitTestVisible="False" BorderThickness="{DynamicResource Theme.Bevel.LightThickness}" BorderBrush="{DynamicResource Theme.Bevel.Light}"/>
    <Border IsHitTestVisible="False" BorderThickness="{DynamicResource Theme.Bevel.DarkThickness}" BorderBrush="{DynamicResource Theme.Bevel.Dark}"/>
    </Grid>
</views:FlyoutWindow>
