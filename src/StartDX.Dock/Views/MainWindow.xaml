<Window x:Class="StartDX.Dock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StartDX.Dock.ViewModels"
        xmlns:theming="clr-namespace:StartDX.Dock.Theming"
        Title="StartDX Dock"
        Width="900" Height="56"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="False" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Panel that follows the dock orientation (horizontal for Top/Bottom, vertical for Left/Right). -->
        <ItemsPanelTemplate x:Key="OrientedPanel">
            <StackPanel Orientation="{Binding DataContext.Orientation, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </ItemsPanelTemplate>

        <!-- ─────────────── Pinned application shortcut ─────────────── -->
        <DataTemplate x:Key="PinnedTemplate" DataType="{x:Type vm:PinnedAppViewModel}">
            <Button Style="{StaticResource Dock.ItemButton}" Click="Pinned_Click" MouseRightButtonUp="Pinned_RightUp"
                    ToolTip="{Binding Name}" Width="44" Height="44">
                <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </DataTemplate>

        <!-- ─────────────── Running window (task switcher button) ─────────────── -->
        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type vm:TaskItem}">
            <Button x:Name="Btn" Style="{StaticResource Dock.ItemButton}" Click="Task_Click" MouseRightButtonUp="Task_RightUp"
                    ToolTip="{Binding Title}" MinWidth="44" MaxWidth="190" MinHeight="44">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Margin="8,0,2,0" MaxWidth="132"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.LabelVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                    <Border x:Name="Indicator" CornerRadius="1.5" Opacity="0.4"
                            Background="{DynamicResource Theme.Item.ActiveIndicator}"
                            HorizontalAlignment="{Binding DataContext.IndicatorH, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="{Binding DataContext.IndicatorV, RelativeSource={RelativeSource AncestorType=Window}}"
                            Width="{Binding DataContext.IndicatorWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="{Binding DataContext.IndicatorHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                    <Setter TargetName="Indicator" Property="Effect" Value="{DynamicResource Theme.Item.ActiveIndicatorEffect}"/>
                    <Setter TargetName="Btn" Property="Background" Value="{DynamicResource Theme.Item.ActiveBackground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter TargetName="Indicator" Property="Opacity" Value="0.18"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ─────────────── Notification-area icon ─────────────── -->
        <DataTemplate x:Key="TrayTemplate" DataType="{x:Type vm:TrayIconItem}">
            <Border Padding="6" Margin="1" Cursor="Hand" ToolTip="{Binding Tooltip}"
                    MouseUp="Tray_MouseUp" CornerRadius="{DynamicResource Theme.Button.CornerRadius}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.Button.HoverBackground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- The dock surface. Background/border come entirely from the active theme. Empty areas are draggable to re-dock,
         right-clickable for the dock menu, and accept dropped .exe/.lnk files to pin them. -->
    <Grid>
    <Border x:Name="Chrome"
            Background="{DynamicResource Theme.Dock.Background}"
            BorderBrush="{DynamicResource Theme.Dock.BorderBrush}"
            BorderThickness="{DynamicResource Theme.Dock.BorderThickness}"
            AllowDrop="True" Drop="Chrome_Drop" DragOver="Chrome_DragOver"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
            MouseMove="Chrome_MouseMove"
            MouseLeftButtonUp="Chrome_MouseLeftButtonUp"
            MouseRightButtonUp="Chrome_MouseRightButtonUp">

        <DockPanel x:Name="Layout" LastChildFill="True" Margin="6,4">

            <!-- Start button: a 2x2 grid of accent tiles -->
            <Button x:Name="StartButton" DockPanel.Dock="Left" Style="{StaticResource Dock.ItemButton}"
                    Click="StartButton_Click" ToolTip="Start" Width="44" Height="44">
                <UniformGrid Rows="2" Columns="2" Width="20" Height="20">
                    <Border Margin="1" CornerRadius="2" Background="{DynamicResource Theme.Accent}"/>
                    <Border Margin="1" CornerRadius="2" Background="{DynamicResource Theme.Accent}" Opacity="0.85"/>
                    <Border Margin="1" CornerRadius="2" Background="{DynamicResource Theme.Accent}" Opacity="0.85"/>
                    <Border Margin="1" CornerRadius="2" Background="{DynamicResource Theme.Accent}" Opacity="0.7"/>
                </UniformGrid>
            </Button>

            <!-- Notification area + notification centre + clock (docked to the far end) -->
            <StackPanel x:Name="TrayCluster" DockPanel.Dock="Right" Orientation="{Binding Orientation}">
                <ItemsControl x:Name="TrayItems" ItemsSource="{Binding TrayIcons}" ItemTemplate="{StaticResource TrayTemplate}"
                              ItemsPanel="{StaticResource OrientedPanel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- System indicators. Click toggles mute, wheel changes volume, right-click opens sound settings. -->
                <StackPanel Orientation="{Binding Orientation}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="InputButton" Style="{StaticResource Dock.ItemButton}" MinWidth="38" Height="44" Padding="4,0"
                            Click="Input_Click" ToolTip="Input language (click to switch)"
                            Visibility="{Binding SystemStatus.HasMultipleInputs, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding SystemStatus.InputText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource Theme.Font.Size.Small}"/>
                    </Button>
                    <Button x:Name="VolumeButton" Style="{StaticResource Dock.ItemButton}" Width="38" Height="44" Padding="0"
                            Click="Volume_Click" MouseWheel="Volume_Wheel" MouseRightButtonUp="Volume_RightUp"
                            ToolTip="{Binding SystemStatus.VolumeText}">
                        <TextBlock Text="{Binding SystemStatus.VolumeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </Button>
                    <Button x:Name="NetworkButton" Style="{StaticResource Dock.ItemButton}" Width="38" Height="44" Padding="0"
                            Click="Network_Click" ToolTip="{Binding SystemStatus.NetworkText}">
                        <TextBlock Text="{Binding SystemStatus.NetworkGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </Button>
                    <Button x:Name="BatteryButton" Style="{StaticResource Dock.ItemButton}" Width="38" Height="44" Padding="0"
                            Click="Battery_Click" ToolTip="{Binding SystemStatus.BatteryText}"
                            Visibility="{Binding SystemStatus.HasBattery, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding SystemStatus.BatteryGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{DynamicResource Theme.Text.Primary}"/>
                    </Button>
                </StackPanel>

                <Button x:Name="NotifButton" Style="{StaticResource Dock.ItemButton}" Click="NotifButton_Click"
                        ToolTip="Notifications" Width="44" Height="44">
                    <Grid Width="24" Height="24">
                        <TextBlock Text="&#xE7E7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource Theme.Text.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Theme.Badge.Background}" CornerRadius="7" MinWidth="14" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                Visibility="{Binding Notifications.HasUnread, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding Notifications.Unread}" FontSize="9" FontWeight="Bold" Margin="3,0"
                                       Foreground="{DynamicResource Theme.Badge.Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="ClockButton" Style="{StaticResource Dock.ItemButton}" Click="ClockButton_Click"
                        MinWidth="{Binding ClockMinWidth}" Padding="2,4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockTime}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{Binding ClockDate}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center"
                                   Visibility="{Binding DateVisibility}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Pinned shortcuts | separator | running windows -->
            <ScrollViewer x:Name="CenterScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="CenterStack" Orientation="{Binding Orientation}">
                    <ItemsControl ItemsSource="{Binding Pinned}" ItemTemplate="{StaticResource PinnedTemplate}"
                                  ItemsPanel="{StaticResource OrientedPanel}"/>
                    <Border x:Name="Divider" Style="{StaticResource Theme.Separator.Style}" Width="1" Height="24"/>
                    <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskTemplate}"
                                  ItemsPanel="{StaticResource OrientedPanel}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
    <Border IsHitTestVisible="False" BorderThickness="{DynamicResource Theme.Bevel.LightThickness}" BorderBrush="{DynamicResource Theme.Bevel.Light}"/>
    <Border IsHitTestVisible="False" BorderThickness="{DynamicResource Theme.Bevel.DarkThickness}" BorderBrush="{DynamicResource Theme.Bevel.Dark}"/>
    </Grid>
</Window>
